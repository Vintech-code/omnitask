# Local development only. Copy to .env.local and keep real values out of Git.
OMNITASK_ENV=development
OMNITASK_EXPECTED_FIREBASE_PROJECT_ID=omnitask-d5b47

# Staging and production must set all values in their own EAS environment.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

GOOGLE_MAPS_API_KEY=
# Optional overrides for native service-file locations:
GOOGLE_SERVICES_FILE=
GOOGLE_SERVICE_INFO_FILE=
