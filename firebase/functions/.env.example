# Non-secret deployment parameters. Firebase prompts for these on first deploy.
SENDGRID_FROM_EMAIL=hello@your-verified-domain.example
SENDGRID_FROM_NAME=OmniTask
APP_CONTINUE_URL=https://omnitask-d5b47.firebaseapp.com
APP_LOGO_URL=https://your-public-domain.example/omnitasklogo.png

# Never put SENDGRID_API_KEY in this file. Set it with:
# firebase functions:secrets:set SENDGRID_API_KEY
