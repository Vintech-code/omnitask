{
  "expo": {
    "name": "OmniTask",
    "slug": "omnitask",
    "scheme": "omnitask",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/omnitasklogo.png",
    "userInterfaceStyle": "automatic",
    "androidStatusBar": {
      "backgroundColor": "#F3F3F1",
      "barStyle": "dark-content",
      "translucent": false
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.VIBRATE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#F3F3F1",
        "foregroundImage": "./assets/omnitasklogo.png"
      },
      "package": "com.vincentements_007.omnitask"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "0e87cf1e-75c1-41a2-b287-37fa22daed11"
      }
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F3F3F1",
          "image": "./assets/omnitasklogo.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#F8F8F5",
            "image": "./assets/omnitasklogo.png"
          }
        }
      ],
      "expo-audio",
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow OmniTask to attach photos to your canvas boards.",
          "cameraPermission": "Allow OmniTask to take photos for your canvas boards.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow OmniTask to use your location when choosing a place for an event."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FF7A00"
        }
      ],
        "./plugins/withAlarmNotificationSounds",
        "./plugins/withOmniTaskHandwriting"
    ]
  }
}
